        "def get_dataset_dimensions(path: str) -> None:\n",
        "    try:\n",
        "        # Abrimos el archivo en modo lectura\n",
        "        with open(path, 'r', encoding='utf-8') as file:\n",
        "            lineas = file.readlines()  # Leer todas las líneas del archivo\n",
        "\n",
        "            if len(lineas) == 0:\n",
        "                print(\"The file is empty.\")  # Si no hay líneas, el archivo está vacío\n",
        "                return\n",
        "\n",
        "            encabezado = lineas[0].strip().split(\",\")  # Primera línea = encabezado, separo con coma y elimino espacios\n",
        "            num_columnas = len(encabezado)\n",
        "            num_filas = len(lineas) - 1  # Restamos 1 por el encabezado\n",
        "\n",
        "            print(\"Columns:\", num_columnas)\n",
        "            print(\"Rows:\", num_filas)\n",
        "\n",
        "    except:\n",
        "        print(\"An error occurred while reading the file.\")"
