      "source": [
        "#Definir filter_palindromes\n",
        "def filter_palindromes(word_list: list[str]) -> list[str]:\n",
        "    \"\"\"\n",
        "    Devuelve una lista con las palabras/frases palíndromas, ignorando espacios y mayúsculas.\n",
        "    \"\"\"\n",
        "    palindromos = []\n",
        "\n",
        "    for palabra in word_list:\n",
        "        limpia = palabra.replace(\" \", \"\").lower() #Quito espacios y mayúsculas\n",
        "        if limpia == limpia[::-1]: #Invierto cada string\n",
        "            palindromos.append(palabra)\n",
        "\n",
        "    return palindromos"
      ]
