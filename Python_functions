            "Selecciona el número del tipo de red Wi-Fi: 3\n",
            "¿La conexión es estable? (sí/no): no\n",
            "¿La conexión es estable?: False\n",
            "Connection to WPA3 Personal network cannot be established\n"
          ]
        }
      ],
      "source": [
        "from unidecode import unidecode\n",
        "\n",
        "# 1. Definir redes seguras e inseguras\n",
        "secure_networks = [\"WPA2 Personal\", \"WPA2 Enterprise\", \"WPA3 Personal\", \"WPA3 Enterprise\"]\n",
        "insecure_networks = [\"WPA Personal\", \"WEP\", \"Open Network\"]\n",
        "\n",
        "# 2. Combinar las dos listas\n",
        "all_networks = secure_networks + insecure_networks\n",
        "\n",
        "# 3. Mostrar todas las redes disponibles usando enumerate\n",
        "print(\"Tipos de redes disponibles:\")\n",
        "for idx, net in enumerate(all_networks, start=1):  # \"start=1\" asegura que la numeración comience desde 1, como indica el enunciado\n",
        "    print(f\"{idx}. {net}\")\n",
        "\n",
        "# 4. Pedir al usuario que seleccione una red por número\n",
        "network_choice = int(input(\"Selecciona el número del tipo de red Wi-Fi: \"))  # Uso int() para convertir la entrada a un número entero, como en los apuntes.\n",
        "\n",
        "# 5. Restamos 1 porque los índices en Python comienzan desde 0\n",
        "selected_network = all_networks[network_choice - 1]\n",
        "\n",
        "# 6. Preguntar si la conexión es estable\n",
        "respuesta = input(\"¿La conexión es estable? (sí/no): \")\n",
        "respuesta = unidecode(respuesta).strip().lower()  # Unidecode elimina tildes, strip() espacios, y lower() convierte todo a minúsculas\n",
        "is_connection_stable = respuesta == \"si\"\n",
        "print(f\"¿La conexión es estable?: {is_connection_stable}\")\n",
        "\n",
        "# 7. Verificar condiciones para conectarse a la red\n",
        "if selected_network in secure_networks and is_connection_stable:\n",
        "    print(f\"User connected to {selected_network}\")\n",
        "else:\n",
        "    print(f\"Connection to {selected_network} network cannot be established\")"
      ]
