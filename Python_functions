        "#1. Definir filter_list1\n",
        "from typing import List\n",
        "\n",
        "def filter_list1(list1: List[int], list2: List[int]) -> List[int]:\n",
        "    \"\"\"\n",
        "    Devuelve una lista con los elementos de list1 que no están en list2.\n",
        "    \"\"\"\n",
        "    list3 = []\n",
        "    for num in list1:\n",
        "        if num not in list2:\n",
        "            list3.append(num)\n",
        "    return list3\n",
        "\n",
        "#2. Definir filter_list2 - List comprehension version\n",
        "def filter_list2(list1: List[int], list2: List[int]) -> List[int]:\n",
