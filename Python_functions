        "def create_gt3_pandas(path: str) -> None:\n",
        "    \"\"\"\n",
        "    Agrega la columna 'gt3' en base a 'gt1' y guarda el nuevo archivo como 'result_pandas.csv'.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        df = pd.read_csv(path)\n",
        "\n",
        "        if 'gt1' not in df.columns:\n",
        "            print(\"La columna 'gt1' no existe en el dataset.\")\n",
        "            return\n",
        "\n",
        "        # Uso lambda para crear 'gt3': si gt1 es 1 = 3, si no 0\n",
        "        df['gt3'] = df['gt1'].apply(lambda x: 3 if x == 1 else 0)\n",
        "\n",
        "        # Ruta completa para guardar el archivo dentro de la carpeta indicada\n",
        "        output_path = '/content/drive/MyDrive/Colab Notebooks/Activity_2/data/result_pandas.csv'\n",
        "        df.to_csv(output_path, index=False)\n",
        "\n",
        "        print(f\"Archivo guardado en: {output_path}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"Error al procesar el archivo con pandas:\", e)\n"
