      "source": [
        "def create_gt3(path: str, output_dir: str = '/content/drive/MyDrive/Colab Notebooks/Activity_2/data') -> None:\n",
        "    \"\"\"\n",
        "    Crea una nueva columna 'gt3' basada en los valores de 'gt1' y guarda el resultado en 'result.csv'.\n",
        "    \"\"\"\n",
        "\n",
        "    try:\n",
        "        with open(path, 'r', encoding='utf-8') as file:\n",
        "            lines = file.readlines()\n",
        "\n",
        "        if len(lines) == 0:\n",
        "            print(\"The file is empty.\")\n",
        "            return\n",
        "\n",
        "        header = lines[0].strip().split(',')\n",
        "\n",
        "        if 'gt1' not in header:\n",
        "            print(\"La columna 'gt1' no existe en el archivo.\")\n",
        "            return\n",
        "\n",
        "        gt1_index = header.index('gt1')\n",
        "\n",
        "        new_lines = [','.join(header + ['gt3']) + '\\n']\n",
        "\n",
        "        for line in lines[1:]:\n",
        "            valores = line.strip().split(',')\n",
        "            gt1 = valores[gt1_index]\n",
        "            gt3 = '3' if gt1 == '1' else '0'  # Nuevo valor donde gt3 es 3 si gt1 es 1 y 0 si esta condición no se cumple\n",
        "            nueva_linea = valores + [gt3]\n",
        "            new_lines.append(','.join(nueva_linea) + '\\n')\n",
        "\n",
        "        output_path = output_dir.rstrip('/') + '/result.csv'  # Ruta final del archivo\n",
        "\n",
        "        with open(output_path, 'w', encoding='utf-8') as out:\n",
        "            out.writelines(new_lines)\n",
        "\n",
        "        print(f\"Archivo guardado en: {output_path}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"Ocurrió un error al procesar el archivo:\", e)\n",
        "        return(output_path)"
      ]
    },
