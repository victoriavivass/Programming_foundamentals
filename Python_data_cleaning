        "# Apartado C\n",
        "# 1. Mostrar estadísticas estándar de las variables numéricas\n",
        "print(stroke_df.describe())\n",
        "\n",
        "# 2. Buscar valores atípicos\n",
        "import numpy as np\n",
        "\n",
        "def detectar_outliers_iqr(df: pd.DataFrame, columnas: list[str],\n",
        "                          coeficiente: float = 1.5) -> pd.DataFrame:\n",
        "    \"\"\"Identifica valores atípicos usando el\n",
        "    rango intercuartílico (IQR) y los sustituye por NaN.\"\"\"\n",
        "    df_copia = df.copy()\n",
        "\n",
        "    for col in columnas:\n",
        "        Q1 = df[col].quantile(0.25)\n",
        "        Q3 = df[col].quantile(0.75)\n",
        "        IQR = Q3 - Q1\n",
        "\n",
        "        # Definir límites\n",
        "        limite_inferior = Q1 - coeficiente * IQR\n",
        "        limite_superior = Q3 + coeficiente * IQR\n",
        "\n",
        "        # Sustituir valores atípicos por NaN\n",
        "        df_copia.loc[(df[col] < limite_inferior) | (df[col] > limite_superior), col] = np.nan\n",
