        "from sklearn.cluster import KMeans\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Seleccionar solo las columnas numéricas para el clustering\n",
        "X = stroke_df_limpio.select_dtypes(include=['number'])\n",
        "\n",
        "# 2. Probar diferentes valores de k para el método de Elbow\n",
        "inertia = []\n",
        "K_range = range(1, 10)\n",
        "\n",
        "for k in K_range:\n",
        "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
        "    kmeans.fit(X)\n",
        "    inertia.append(kmeans.inertia_)\n",
        "\n",
        "# 3. Gráficar del método de Elbow\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.plot(K_range, inertia, marker='o', linestyle='--')\n",
        "plt.xlabel(\"Número de Clusters (k)\")\n",
        "plt.ylabel(\"Inercia\")\n",
        "plt.title(\"Método de Elbow para selección óptima de k\")\n",
        "plt.show()"
      ],
